    function processBulkPaste() {
      const text = document.getElementById("bulkPasteInput").value.trim();
      if (!text) return closeBulkPasteModal();

      const lines = text.split("\n");
      const newTasks = [];

      const uuidRegex = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i;
      const lsrRegex = /[0-9a-f]{24}/i;

      lines.forEach(line => {
        const row = line.trim();
        if (!row) return;

        let batchId = "", taskId = "", uniqueName = "";
        let valSt = 0, valMt = 0, misSt = 0, misMt = 0, prSt = 0, prMt = 0, fp = 0, tc = "No";

        const cols = row.includes("\t") ? row.split("\t") : row.split(",");

        if (cols.length >= 4 && !row.includes("Imerit-Batch")) {
          batchId = cols[0] ? cols[0].trim() : "";
          taskId = cols[1] ? cols[1].trim() : "";
          uniqueName = cols[2] ? cols[2].trim() : "";
          valSt = Number(cols[3]) || 0;
          valMt = Number(cols[4]) || 0;
          misSt = Number(cols[5]) || 0;
          misMt = Number(cols[6]) || 0;
          prSt = Number(cols[7]) || 0;
          prMt = Number(cols[8]) || 0;
          fp = Number(cols[9]) || 0;
          tc = cols[10] && cols[10].trim().toLowerCase() === "yes" ? "Yes" : "No";
        } else {
          const uuidMatch = row.match(uuidRegex);
          const lsrMatch = row.match(lsrRegex);

          if (uuidMatch) {
            taskId = uuidMatch[0];
            const uuidIndex = row.indexOf(taskId);
            batchId = row.substring(0, uuidIndex).trim().replace(/[-_ ]+$/, "");
            const remainingAfterUuid = row.substring(uuidIndex + taskId.length).trim();
            uniqueName = lsrMatch ? lsrMatch[0] : (remainingAfterUuid || "");
          } else {
            const parts = row.split(/\s+/);
            if (parts.length >= 3) {
              batchId = parts[0];
              taskId = parts[1];
              uniqueName = parts[2];
            } else {
              taskId = parts[0];
            }
          }
        }

        if (taskId) {
          newTasks.push({ batchId, taskId, uniqueName, valSt, valMt, misSt, misMt, prSt, prMt, fp, tc, status: (tc === "Yes" ? "Done" : "WIP") });
        }
      });

      if (newTasks.length > 0) {
        const existingTasks = extractCurrentTasks();
        if (existingTasks.length === 1 && !existingTasks[0].taskId) {
          document.getElementById("tasksContainer").innerHTML = "";
        }
        newTasks.forEach(task => addTask(task));
        autoSave();
        showMessage(`Successfully imported ${newTasks.length} tasks!`, "success");
      }
      closeBulkPasteModal();
    }

