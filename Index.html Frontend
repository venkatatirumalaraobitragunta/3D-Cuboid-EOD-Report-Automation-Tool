    function formatTpst(sec) {
      const val = Number(sec || 0);
      if (val <= 0) return "0s";
      if (val <= 60) return `${Number.isInteger(val) ? val : val.toFixed(1)}s`;
      return `${Math.floor(val / 60)} min:${String(Math.round(val % 60)).padStart(2, '0')}s`;
    }

    // CHANGE 1 (NEW HELPER): Overall TPST display only.
    // Whole seconds, never decimals. < 60s => "45s" | >= 60s => "m:ss min".
    // Returns "" for invalid/empty input so the caller can fall back to "NA".
    function formatOverallTpst(value) {
      if (value === null || value === undefined || String(value).trim() === "") return "";
      const n = Number(value);
      if (!isFinite(n) || n < 0) return "";
      const roundedSeconds = Math.round(n);
      if (roundedSeconds < 60) return `${roundedSeconds}s`;
      const minutes = Math.floor(roundedSeconds / 60);
      const seconds = roundedSeconds % 60;
      return `${minutes}:${String(seconds).padStart(2, "0")} min`;
    }

    // STRICT BENCHMARK EVALUATION (Green: ST <= 45s AND MT <= 6 min)
    function getPerformanceStatus(stTpst, mtTpst, stObjects, mtObjects, targetST) {
      const totalObjects = (stObjects || 0) + (mtObjects || 0);

      if (totalObjects === 0) {
        return { label: "No Activity", className: "status-gray" };
      }

      const st = Number(stTpst) || 0;
      const mt = Number(mtTpst) || 0;

      // STRICT CEILINGS:
      const ST_GREEN_LIMIT = Number(targetST) || 45; // Default 45s
      const ST_YELLOW_LIMIT = 60;
      const MT_GREEN_LIMIT = 360;  // Strict 6 Minutes (360 seconds)
      const MT_YELLOW_LIMIT = 480; // Strict 8 Minutes (480 seconds)

      // 1. Red: ST > 60s OR MT > 8 mins
      if ((stObjects > 0 && st > ST_YELLOW_LIMIT) || (mtObjects > 0 && mt > MT_YELLOW_LIMIT)) {
        return { label: "Needs Attention", className: "status-red" };
      }

      // 2. Green: Strictly ST <= 45s AND MT <= 6 min (360s)
      const isSTGreen = stObjects > 0 ? (st <= ST_GREEN_LIMIT) : true;
      const isMTGreen = mtObjects > 0 ? (mt <= MT_GREEN_LIMIT) : true;

      if (isSTGreen && isMTGreen) {
        return { label: "On Track", className: "status-green" };
      }

      // 3. Yellow: Between 6 min and 8 min (e.g. 7:30 min)
      return { label: "Close", className: "status-yellow" };
    }

    // =========================================================================
    // SINGLE SOURCE OF TRUTH FOR STATUS
    // Used by BOTH the top progress/status card and the TPST box.
    // Status is rate/count based only. Workload > shift capacity (Surplus) never
    // makes it "Needs Attention".
    // =========================================================================
    function computeSharedStatus(data) {
      let st = 0, mt = 0;
      (data.tasks || []).forEach(t => {
        st += (t.valSt || 0) + (t.misSt || 0) + (t.prSt || 0);
        mt += (t.valMt || 0) + (t.misMt || 0) + (t.prMt || 0);
      });
      return getPerformanceStatus(data.actualSTSec || 0, data.actualMTSec || 0, st, mt, data.targetSTSec);
    }
    const STATUS_KIND = { "status-green": "green", "status-yellow": "yellow", "status-red": "red", "status-gray": "gray" };

    // =========================================================================
    // SHARED PROGRESS BAR (targetGapCard) - ONE BAR, TWO MODES
    //   Generate Allocation -> Shift Allocation Progress (required workload vs shift)
    //   Fill Full Shift     -> Target-rate benchmark progress (workload vs capacity)
    // All numbers come from data.progress returned by the backend, which reuses the
    // backend's effective-shift / downtime / FP / TC calculation. The shift length now
    // comes from the selected Location + Shift (or Custom).
    // Bar color + badge always follow computeSharedStatus().
    // =========================================================================
    function fmtUnits(n) {
      n = Number(n || 0);
      return Number.isInteger(n) ? String(n) : n.toFixed(1);
    }

    function fmtMinSec(sec) {
      sec = Math.max(0, Math.round(Number(sec || 0)));
      return `${String(Math.floor(sec / 60)).padStart(2, "0")}:${String(sec % 60).padStart(2, "0")}`;
    }

    function gapChip(label, value) {
      return `<span class="gap-chip"><span class="gap-chip-label">${label}:</span> <strong>${value}</strong></span>`;
    }

    function setGapBadge(badgeEl, kind, text) {
      const palette = {
        blue:   { bg: "rgba(59, 130, 246, 0.15)", fg: "#2563eb", bd: "rgba(59, 130, 246, 0.3)" },
        yellow: { bg: "rgba(245, 158, 11, 0.15)", fg: "#d97706", bd: "rgba(245, 158, 11, 0.3)" },
        green:  { bg: "rgba(34, 197, 94, 0.15)",  fg: "#16a34a", bd: "rgba(34, 197, 94, 0.3)" },
        red:    { bg: "rgba(239, 68, 68, 0.15)",  fg: "#b91c1c", bd: "rgba(239, 68, 68, 0.3)" },
        gray:   { bg: "rgba(148, 163, 184, 0.2)", fg: "#64748b", bd: "rgba(148, 163, 184, 0.4)" }
      }[kind];
      badgeEl.style.background = palette.bg;
      badgeEl.style.color = palette.fg;
      badgeEl.style.border = `1px solid ${palette.bd}`;
      badgeEl.innerText = text;
    }

    function renderSharedProgressBar(data) {
      const gapCard = document.getElementById("targetGapCard");
      if (!gapCard) return;

      const p = data && data.progress;
      if (!p) {
        gapCard.style.display = "none";
        return;
      }

      const gapTitle = document.getElementById("targetGapTitle");
      const gapBadge = document.getElementById("targetGapBadge");
      const gapBar = document.getElementById("targetGapBar");
      const gapDetails = document.getElementById("targetGapDetails");

      gapCard.style.display = "block";
      hideStaleHint();

      const BAR_COLORS = { blue: "#3b82f6", yellow: "#eab308", green: "#22c55e", red: "#ef4444", gray: "#94a3b8" };

      // ONE status for the whole screen (same one used in the TPST box)
      const status = computeSharedStatus(data);
      const statusKind = STATUS_KIND[status.className] || "gray";

      if (p.mode === "autofit") {
        // ---------- AUTO-FIT MODE: workload vs benchmark capacity at target ST rate ----------
        const target = p.targetSTSec;
        const rate = p.currentSTRate;
        const gap = p.stGapSec;
        const rawPct = Math.max(0, p.benchmarkPct);
        const barPct = Math.min(100, rawPct);
        const atOrBelowTarget = gap <= 0.05;
        const gapText = `${gap >= 0 ? "+" : "-"}${Math.abs(gap).toFixed(1)} sec`;

        gapBar.style.width = `${barPct}%`;
        gapBar.style.background = BAR_COLORS[statusKind];
        gapTitle.innerHTML = `${atOrBelowTarget ? "✨" : "⚠️"} ${target}s Target Progress — <strong>${rawPct.toFixed(1)}%</strong>`;
        setGapBadge(gapBadge, statusKind, `${status.label} • ` + (atOrBelowTarget ? `At/below target (${gapText})` : `Gap ${gapText}`));

        let capacityLine;
        if (p.additionalUnits > 0) {
          capacityLine = `
            <div style="margin-top:4px;">
              🎯 <strong>Additional target-rate workload capacity:</strong>
              <span style="color:#2563eb; font-weight:700;">+${p.additionalUnits} ST-equivalent units</span>
              (≈ <span style="color:#2563eb; font-weight:700;">+${p.additionalUnits} ST</span> <i>or</i>
              <span style="color:#7c3aed; font-weight:700;">+${p.additionalMT} MT</span> at ${target}s ST / ${fmtMinSec(p.targetMTSec)} MT)
            </div>
            <div class="gap-note">This is how much more work fits at the target rate. It does not change the current average rate.</div>`;
        } else {
          capacityLine = `
            <div style="margin-top:4px;">✅ <strong>Workload is at or above benchmark capacity</strong> — no additional target-rate capacity left in this shift.</div>`;
        }

        gapDetails.innerHTML = `
          <div class="gap-chips">
            ${gapChip("Current ST Rate", `${rate.toFixed(1)} sec`)}
            ${gapChip("Target", `${target} sec`)}
            ${gapChip("Gap", gapText)}
            ${gapChip("Current workload", `${fmtUnits(p.currentWorkloadUnits)} units`)}
            ${gapChip("Benchmark capacity", `${fmtUnits(p.benchmarkCapacityUnits)} units`)}
          </div>
          ${capacityLine}
          <div class="gap-note">Units are ST-equivalent (1 MT = ${fmtUnits(p.benchmarkRatio)} ST). Capacity = productive time after downtime (${formatDuration(p.downtimeSec)}) and FP/TC (${formatDuration(p.fixedNonProductiveSec)}) ÷ ${target}s.</div>
        `;
      } else {
        // ---------- GENERATE MODE: required workload vs effective shift ----------
        const pct = Math.max(0, p.fillPct);
        const barPct = Math.min(100, pct);
        const hasSurplus = p.overSec > 0;
        const pctText = (pct >= 99.95 && pct < 100.05) ? "100.0" : pct.toFixed(1);

        gapBar.style.width = `${barPct}%`;
        gapBar.style.background = BAR_COLORS[statusKind];
        gapTitle.innerHTML = `${hasSurplus ? "📈" : "📊"} Shift Allocation Progress — <strong>${pctText}% FILLED</strong>`;
        setGapBadge(gapBadge, statusKind, hasSurplus
          ? `${status.label} • Surplus ${formatDuration(p.overSec)}`
          : `${status.label} • Remaining ${formatDuration(p.remainingSec)}`);

        gapDetails.innerHTML = `
          <div class="gap-chips">
            ${gapChip("Required Workload", formatDuration(p.requiredSec))}
            ${gapChip("Available", formatDuration(p.effectiveSec))}
            ${hasSurplus ? gapChip("Surplus", formatDuration(p.overSec)) : gapChip("Remaining to fill", formatDuration(p.remainingSec))}
            ${gapChip("Target", `${p.targetSTSec} sec/ST`)}
            ${gapChip("MT Target", `${fmtMinSec(p.targetMTSec)} min`)}
            ${gapChip("Downtime removed", formatDuration(p.downtimeSec))}
          </div>
        `;
      }
    }

    function markBarStale() {
      if (!generatedData) return;
      const el = document.getElementById("targetGapStale");
      const card = document.getElementById("targetGapCard");
      if (el && card && card.style.display !== "none") el.style.display = "block";
    }

    function hideStaleHint() {
      const el = document.getElementById("targetGapStale");
      if (el) el.style.display = "none";
    }

    function renderOutput(data) {
      const output = document.getElementById("outputArea");
      const summary = document.getElementById("summary");
      const legendBar = document.getElementById("legendBar");
      const subtitle = document.getElementById("outputSubtitle");
      const shiftPill = document.getElementById("shiftPill");
      const varianceBox = document.getElementById("varianceAlert");
      const varianceMsg = document.getElementById("varianceMessage");

      if (!data || !data.tasks) {
        summary.style.display = "none";
        legendBar.style.display = "none";
        shiftPill.style.display = "none";
        varianceBox.style.display = "none";
        document.getElementById("targetGapCard").style.display = "none";
        output.innerHTML = `<div class="empty-output"><div class="empty-output-title">No allocation generated</div>Enter your task details and generate allocation.</div>`;
        return;
      }

      const modeText = data.fitToShift ? "Auto-Fit Mode" : `Target ST: ${data.targetSTSec}s`;
      const downtimeText = data.downtimeMin > 0 ? ` • Downtime: ${data.downtimeMin}m` : "";
      const locationText = data.location ? ` • ${data.location}` : "";
      subtitle.textContent = `${data.date}${locationText} • Window: ${data.shiftWindow} • ${modeText}${downtimeText}`;
      shiftPill.textContent = data.shiftLabel || data.shift;
      shiftPill.style.display = "block";
      summary.style.display = "grid";
      legendBar.style.display = "flex";

      const actualST = data.actualSTSec || 0;
      const totalObj = (data.summary.stObjects || 0) + ((data.summary.mtObjects || 0) * 10); // weighted count

      if (actualST > 60 && totalObj > 0) {
        varianceBox.style.display = "flex";
        varianceMsg.textContent = `Actual TPST (${formatTpst(actualST)}) exceeded target because total count (${totalObj}) is low for the ${formatHoursMinutes(data.summary.availableSec)}h shift workload.`;
      } else {
        varianceBox.style.display = "none";
      }

      updateSummary();

      // Shared bar: mode (Generate vs Auto-Fit) comes from the backend result.
      renderSharedProgressBar(data);

      if (data.tasks.length === 0) {
        output.innerHTML = `<div class="empty-output"><div class="empty-output-title">No tasks remaining</div>All tasks removed.</div>`;
        return;
      }

      let html = `
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Task</th>
                <th>Status</th>
                <th>Task Counts</th>
                <th>Validation (ST / MT)</th>
                <th>Missing (ST / MT)</th>
                <th>Pitch & Roll (ST / MT)</th>
                <th>FP</th>
                <th>TC</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
      `;

      data.tasks.forEach((task, index) => {
        const renderSubStage = (label, count, start, end, sec) => {
          if (count <= 0) return `<div style="font-size:10px; color:#94a3b8;">${label}: 0</div>`;
          return `
            <div style="margin-bottom: 4px;">
              <span style="font-weight:700; color:var(--text);">${label}: ${count}</span> 
              <span class="allocation-time">(${formatDuration(sec)})</span>
              <div class="timing-stack">
                <span class="time-item">${start} <button type="button" class="copy-btn" onclick="copyText('${start}', this)">📋</button></span>
                <span class="time-item">${end} <button type="button" class="copy-btn" onclick="copyText('${end}', this)">📋</button></span>
              </div>
            </div>
          `;
        };

        const getStatusBadge = (st) => {
          let cls = "status-wip";
          if (st === "Done") cls = "status-done";
