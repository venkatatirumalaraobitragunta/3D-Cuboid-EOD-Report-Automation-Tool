    function formatDuration(sec) {
      sec = Math.max(0, Number(sec || 0));
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = Math.floor(sec % 60);
      return `${String(h).padStart(2,"0")}:${String(m).padStart(2,"0")}:${String(s).padStart(2,"0")}`;
    }

    function escapeHtml(val) {
      return String(val).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    // =========================================================================
    // PRODUCTION REFERENCE CALCULATOR (NEW, ISOLATED)
    // - Every function / constant / variable here starts with refCalc_
    // - Reads ONLY the refCalc_* elements; never touches main-app IDs, globals,
    //   localStorage or backend. No google.script.run calls.
    // - Benchmarks below are private to this calculator (NOT the main CONFIG).
    // =========================================================================
    const refCalc_LOCATION_DEFAULTS = {
      "Hyderabad": "07:30:00",
      "Saltlake":  "08:00:00",
      "Metiabrux": "07:30:00"
    };
    const refCalc_BENCHMARK_ST_SEC = 45;   // 45 sec per count
    const refCalc_BENCHMARK_MT_SEC = 360;  // 6 min per count

    function refCalc_el(id) { return document.getElementById(id); }

    // Parses "HH:MM:SS" (also accepts "HH:MM"). Returns total seconds, or null if invalid.
    function refCalc_parseTime(str) {
      const m = String(str || "").trim().match(/^(\d+):(\d{1,2})(?::(\d{1,2}))?$/);
      if (!m) return null;
      const h = Number(m[1]), mi = Number(m[2]), s = m[3] === undefined ? 0 : Number(m[3]);
      if (mi > 59 || s > 59) return null;
      return h * 3600 + mi * 60 + s;
    }

    // Formats seconds (rounded to the nearest whole second) as HH:MM:SS
    function refCalc_formatTime(sec) {
      sec = Math.max(0, Math.round(Number(sec) || 0));
      const h = Math.floor(sec / 3600);
      const m = Math.floor((sec % 3600) / 60);
      const s = sec % 60;
      return String(h).padStart(2, "0") + ":" + String(m).padStart(2, "0") + ":" + String(s).padStart(2, "0");
    }

    // Accepts "HH:MM:SS", "MM:SS" or plain seconds for the optional status check input.
    function refCalc_parseFlexible(str) {
      const t = String(str || "").trim();
      if (!t) return null;
      if (/^\d+(\.\d+)?$/.test(t)) return Number(t);
      const parts = t.split(":");
      if (parts.some(p => !/^\d+(\.\d+)?$/.test(p))) return NaN;
      if (parts.length === 2) return Number(parts[0]) * 60 + Number(parts[1]);
      if (parts.length === 3) return Number(parts[0]) * 3600 + Number(parts[1]) * 60 + Number(parts[2]);
      return NaN;
    }

    function refCalc_showMessage(msg) {
      const box = refCalc_el("refCalc_message");
      if (!box) return;
      if (msg) {
        box.textContent = msg;
        box.classList.add("refCalc_show");
      } else {
        box.textContent = "";
        box.classList.remove("refCalc_show");
      }
    }

    // Standard Mode status reference (display only). Calculator-specific; independent of the main app.
    // type: "ST" | "MT", sec: actual TPST in seconds (null/NaN => gray)
    function refCalc_getStandardStatus(type, sec) {
      if (sec === null || sec === undefined || isNaN(sec) || sec <= 0) {
        return { label: "No Activity", cls: "refCalc_gray" };
      }
      const green = type === "ST" ? 45 : 360;
      const yellow = type === "ST" ? 60 : 480;
      if (sec <= green)  return { label: "On Track", cls: "refCalc_green" };
      if (sec <= yellow) return { label: "Close", cls: "refCalc_yellow" };
      return { label: "Needs Attention", cls: "refCalc_red" };
    }

    // Expected count = working seconds / benchmark TPST, rounded to a whole number
    function refCalc_calculateStandard(workingSec) {
      return {
        stCount: Math.round(workingSec / refCalc_BENCHMARK_ST_SEC),
        mtCount: Math.round(workingSec / refCalc_BENCHMARK_MT_SEC)
      };
    }

    // Actual TPST (seconds) = working seconds / count. Returns null when count <= 0.
    function refCalc_calculateNormal(workingSec, count) {
      if (!Number.isInteger(count) || count <= 0) return null;
      return workingSec / count;
    }

    function refCalc_renderStandard(workingSec) {
      const r = refCalc_calculateStandard(workingSec);
      const stStatus = refCalc_getStandardStatus("ST", refCalc_parseFlexible(refCalc_el("refCalc_checkST") ? refCalc_el("refCalc_checkST").value : ""));
      const mtStatus = refCalc_getStandardStatus("MT", refCalc_parseFlexible(refCalc_el("refCalc_checkMT") ? refCalc_el("refCalc_checkMT").value : ""));
      return `
        <div class="refCalc_tableWrap">
          <table class="refCalc_table">
            <thead>
              <tr><th>Type</th><th>TPST</th><th>Expected Count</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>ST</strong></td>
                <td class="refCalc_mono">${refCalc_formatTime(refCalc_BENCHMARK_ST_SEC)}</td>
                <td class="refCalc_big">${r.stCount}</td>
              </tr>
              <tr>
                <td><strong>MT</strong></td>
                <td class="refCalc_mono">${refCalc_formatTime(refCalc_BENCHMARK_MT_SEC)}</td>
                <td class="refCalc_big">${r.mtCount}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="refCalc_tableWrap">
          <table class="refCalc_table">
            <thead>
              <tr><th>Status Reference</th><th>Green / On Track</th><th>Yellow / Close</th><th>Red / Needs Attention</th><th>Check Actual TPST (optional)</th><th>Status</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>ST</strong></td>
                <td>&le; 00:00:45</td>
                <td>&gt; 00:00:45 to &le; 00:01:00</td>
                <td>&gt; 00:01:00</td>
                <td><input type="text" id="refCalc_checkST" class="refCalc_checkInput" placeholder="e.g. 50 or 00:50" autocomplete="off"></td>
                <td><span id="refCalc_statusST" class="refCalc_badge ${stStatus.cls}">${stStatus.label}</span></td>
              </tr>
              <tr>
                <td><strong>MT</strong></td>
                <td>&le; 00:06:00</td>
                <td>&gt; 00:06:00 to &le; 00:08:00</td>
                <td>&gt; 00:08:00</td>
                <td><input type="text" id="refCalc_checkMT" class="refCalc_checkInput" placeholder="e.g. 07:30" autocomplete="off"></td>
                <td><span id="refCalc_statusMT" class="refCalc_badge ${mtStatus.cls}">${mtStatus.label}</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="refCalc_note">Status is a display-only reference. Enter seconds, MM:SS or HH:MM:SS to check an actual TPST.</div>
      `;
    }

    function refCalc_renderNormal(workingSec, count) {
      const tpstSec = refCalc_calculateNormal(workingSec, count);
      const tpstText = tpstSec === null ? "--" : refCalc_formatTime(tpstSec);
      const countText = (Number.isInteger(count) && count > 0) ? String(count) : "--";
      return `
        <div class="refCalc_tableWrap">
          <table class="refCalc_table">
            <thead>
              <tr><th>Working Time</th><th>Count</th><th>Actual TPST</th></tr>
            </thead>
            <tbody>
              <tr>
                <td class="refCalc_mono">${refCalc_formatTime(workingSec)}</td>
                <td class="refCalc_mono">${countText}</td>
                <td class="refCalc_big">${tpstText}</td>
              </tr>
            </tbody>
          </table>
        </div>
      `;
    }

    // Live update: validates inputs, then renders the table for the selected mode.
    function refCalc_update() {
      const result = refCalc_el("refCalc_result");
      if (!result) return;

      const mode = refCalc_el("refCalc_mode").value;
      refCalc_el("refCalc_countField").style.display = (mode === "normal") ? "flex" : "none";

      const workingSec = refCalc_parseTime(refCalc_el("refCalc_workingTime").value);
      if (workingSec === null) {
        refCalc_showMessage("Enter Working Time as HH:MM:SS (minutes and seconds 00-59).");
        result.innerHTML = "";
        return;
      }
      if (workingSec <= 0) {
        refCalc_showMessage("Working Time must be greater than 00:00:00.");
        result.innerHTML = "";
        return;
      }

      if (mode === "normal") {
        const rawCount = refCalc_el("refCalc_count").value.trim();
        const count = rawCount === "" ? NaN : Number(rawCount);
        if (rawCount === "") {
          refCalc_showMessage("");
        } else if (!Number.isInteger(count) || count <= 0) {
          refCalc_showMessage("Count must be a whole number greater than 0.");
        } else {
          refCalc_showMessage("");
        }
        result.innerHTML = refCalc_renderNormal(workingSec, count);
      } else {
        refCalc_showMessage("");
        // Preserve whatever the user typed in the optional status-check boxes across re-renders.
        const prevST = refCalc_el("refCalc_checkST") ? refCalc_el("refCalc_checkST").value : "";
        const prevMT = refCalc_el("refCalc_checkMT") ? refCalc_el("refCalc_checkMT").value : "";
        result.innerHTML = refCalc_renderStandard(workingSec);
        refCalc_el("refCalc_checkST").value = prevST;
        refCalc_el("refCalc_checkMT").value = prevMT;
        refCalc_updateStatusOnly();
        refCalc_el("refCalc_checkST").addEventListener("input", refCalc_updateStatusOnly);
        refCalc_el("refCalc_checkMT").addEventListener("input", refCalc_updateStatusOnly);
      }
    }

    // Updates only the two status badges (keeps focus in the text box while typing).
    function refCalc_updateStatusOnly() {
      const stBadge = refCalc_el("refCalc_statusST");
      const mtBadge = refCalc_el("refCalc_statusMT");
      if (!stBadge || !mtBadge) return;
      const st = refCalc_getStandardStatus("ST", refCalc_parseFlexible(refCalc_el("refCalc_checkST").value));
      const mt = refCalc_getStandardStatus("MT", refCalc_parseFlexible(refCalc_el("refCalc_checkMT").value));
      stBadge.className = "refCalc_badge " + st.cls;
      stBadge.textContent = st.label;
      mtBadge.className = "refCalc_badge " + mt.cls;
      mtBadge.textContent = mt.label;
    }

    // Loads the calculator's own default working time for the selected calculator location.
    function refCalc_onLocationChange() {
      const loc = refCalc_el("refCalc_location").value;
      if (refCalc_LOCATION_DEFAULTS[loc]) {
        refCalc_el("refCalc_workingTime").value = refCalc_LOCATION_DEFAULTS[loc];
      }
      refCalc_update();
    }

    // Count: whole numbers only. Strips anything that is not a digit (blocks ".", "-", "e", etc.).
    function refCalc_onCountInput() {
      const input = refCalc_el("refCalc_count");
      const cleaned = input.value.replace(/\D/g, "");
      if (cleaned !== input.value) {
        input.value = cleaned;
        refCalc_showMessage("Count accepts whole numbers only (no decimals).");
        // keep the live result in sync without clearing that message
        const workingSec = refCalc_parseTime(refCalc_el("refCalc_workingTime").value);
        if (workingSec !== null && workingSec > 0) {
          const c = cleaned === "" ? NaN : Number(cleaned);
          refCalc_el("refCalc_result").innerHTML = refCalc_renderNormal(workingSec, c);
        }
        return;
      }
      refCalc_update();
    }

    function refCalc_onCountKeydown(e) {
      if (e.key === "." || e.key === "," || e.key === "-" || e.key === "+" || e.key === "e" || e.key === "E") {
        e.preventDefault();
        refCalc_showMessage("Count accepts whole numbers only (no decimals).");
      }
    }

    // Tidy the time display (e.g. "7:30" -> "07:30:00") once the user leaves the field.
    function refCalc_onTimeBlur() {
      const sec = refCalc_parseTime(refCalc_el("refCalc_workingTime").value);
      if (sec !== null && sec > 0) {
        refCalc_el("refCalc_workingTime").value = refCalc_formatTime(sec);
      }
      refCalc_update();
    }

    function refCalc_initialize() {
      try {
        if (!refCalc_el("refCalc_container")) return;
        refCalc_el("refCalc_location").addEventListener("change", refCalc_onLocationChange);
        refCalc_el("refCalc_mode").addEventListener("change", refCalc_update);
        refCalc_el("refCalc_workingTime").addEventListener("input", refCalc_update);
        refCalc_el("refCalc_workingTime").addEventListener("blur", refCalc_onTimeBlur);
        refCalc_el("refCalc_count").addEventListener("input", refCalc_onCountInput);
        refCalc_el("refCalc_count").addEventListener("keydown", refCalc_onCountKeydown);
        refCalc_el("refCalc_count").addEventListener("paste", function() { setTimeout(refCalc_onCountInput, 0); });
        refCalc_onLocationChange(); // loads Hyderabad default (07:30:00) and renders
      } catch (e) {
        console.error("refCalc_initialize error", e);
      }
    }

    // Runs independently of window.onload (which the main app already uses; it is left untouched).
    refCalc_initialize();
  </script>
</body>
</html>
