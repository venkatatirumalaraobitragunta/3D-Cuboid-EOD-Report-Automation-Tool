    function handleShiftChange() {
      const shift = document.getElementById("shift").value;
      const isCustom = (shift === "Custom");
      document.getElementById("customStartTimeField").style.display = isCustom ? "flex" : "none";
      document.getElementById("customEndTimeField").style.display = isCustom ? "flex" : "none";
      updateRefLabel();
