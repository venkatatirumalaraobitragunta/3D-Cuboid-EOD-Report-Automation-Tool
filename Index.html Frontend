    // Shift duration comes straight from the selected production window (end - start).
    function calculateTotalShiftSeconds() {
      const location = document.getElementById("location").value;
      const shift = document.getElementById("shift").value;

      let startVal = null, endVal = null;
      if (shift === "Custom") {
        startVal = document.getElementById("customStartTime").value || "09:00";
        endVal = document.getElementById("customEndTime").value || "17:30";
      } else if (location && LOCATION_SHIFTS[location] && LOCATION_SHIFTS[location][shift]) {
        startVal = LOCATION_SHIFTS[location][shift].start;
        endVal = LOCATION_SHIFTS[location][shift].end;
      }

      if (!startVal || !endVal) return 7.5 * 60 * 60; // no location yet: display default only

      const startParts = startVal.split(":").map(Number);
      const endParts = endVal.split(":").map(Number);
      const startSec = startParts[0] * 3600 + startParts[1] * 60;
      let endSec = endParts[0] * 3600 + endParts[1] * 60;
      if (endSec <= startSec) endSec += 24 * 3600;
      return Math.max(0, endSec - startSec);
    }

    function formatHoursMinutes(totalSec) {
      const h = Math.floor(totalSec / 3600);
      const m = Math.round((totalSec % 3600) / 60);
      return m === 0 ? `${h}:00` : `${h}:${String(m).padStart(2, "0")}`;
    }

    function updateRefLabel() {
      const selectedVal = 45;
      const downtimeMin = Math.max(0, Number(document.getElementById("downtimeMin").value || 0));
      const totalShiftSec = calculateTotalShiftSeconds();
      const effectiveShiftSec = Math.max(0, totalShiftSec - (downtimeMin * 60));
      
      const targetCount = Math.round(effectiveShiftSec / selectedVal);
      const targetMtCount = Math.round(effectiveShiftSec / (selectedVal * 8));

      const desc = document.getElementById("reverseCalcDesc");
      if (desc) desc.textContent = `Standard benchmark (${formatHoursMinutes(totalShiftSec)} hrs @ ${selectedVal}s ST / ${fmtMinSec(selectedVal * 8)}m MT target):`;

      document.getElementById("reqStCount").textContent = `~${targetCount} items`;
      document.getElementById("reqMtCount").textContent = `~${targetMtCount} items`;
      document.getElementById("refSTRate").textContent = `Selected: ${selectedVal} sec / object`;
      document.getElementById("refMTRate").textContent = `6:00 min (360 sec) / object`;
    }

    function autoSave() {
      const state = {
        date: document.getElementById("date").value,
        location: document.getElementById("location").value,
        shift: document.getElementById("shift").value,
        customStartTime: document.getElementById("customStartTime").value,
        customEndTime: document.getElementById("customEndTime").value,
        downtimeMin: document.getElementById("downtimeMin").value,
        tasks: extractCurrentTasks()
      };
      try {
        localStorage.setItem("tirumala_time_alloc_state", JSON.stringify(state));
      } catch (e) { console.error("Local storage save error", e); }

      // Any input change after a run means the shared bar is out of date until the next run.
      markBarStale();
    }

    function restoreSavedData() {
      const raw = localStorage.getItem("tirumala_time_alloc_state");
      if (raw) {
        try {
          const state = JSON.parse(raw);
          if (state.date) document.getElementById("date").value = state.date;

          // Location + dynamic shift list
          const savedLocation = (state.location && LOCATION_SHIFTS[state.location]) ? state.location : "";
          document.getElementById("location").value = savedLocation;

          // Map old saved shift names (from previous version) to the new ones
          let savedShift = state.shift;
          if (savedShift === "Morning Shift") savedShift = "Shift 1";
          else if (savedShift === "Evening Shift") savedShift = "Shift 2";

          populateShiftOptions(savedLocation, savedShift);

          if (state.customStartTime) document.getElementById("customStartTime").value = state.customStartTime;
          if (state.customEndTime) document.getElementById("customEndTime").value = state.customEndTime;
          if (state.downtimeMin) document.getElementById("downtimeMin").value = state.downtimeMin;

          handleShiftChange();

          if (Array.isArray(state.tasks) && state.tasks.length > 0) {
            state.tasks.forEach(t => addTask(t));
            return;
          }
        } catch (e) { console.error("Could not parse saved state", e); }
      }
      setToday();
      handleShiftChange();
      addTask();
    }

