    function clearZero(input) { if (input.value === "0") input.value = ""; }
    function restoreZero(input) { if (input.value.trim() === "") input.value = "0"; }

    function setFormLoading(isLoading) {
      const btn1 = document.getElementById("generateBtn");
      const btn2 = document.getElementById("fitShiftBtn");
      btn1.disabled = isLoading;
      btn2.disabled = isLoading;
      btn1.textContent = isLoading ? "Calculating..." : "Generate Allocation (Ctrl+Enter)";
      btn2.textContent = isLoading ? "Fitting..." : "⚡ Fill Full Shift (Auto-Fit Count)";
    }

    function extractCurrentTasks() {
      const cards = document.querySelectorAll(".task-card");
      const tasks = [];
      cards.forEach(card => {
        tasks.push({
          batchId: card.querySelector(".batchId").value.trim(),
          taskId: card.querySelector(".taskId").value.trim(),
          uniqueName: card.querySelector(".uniqueName").value.trim(),
          valSt: Number(card.querySelector(".valSt").value) || 0,
          valMt: Number(card.querySelector(".valMt").value) || 0,
          misSt: Number(card.querySelector(".misSt").value) || 0,
          misMt: Number(card.querySelector(".misMt").value) || 0,
          prSt: Number(card.querySelector(".prSt").value) || 0,
          prMt: Number(card.querySelector(".prMt").value) || 0,
          fp: Number(card.querySelector(".fp").value) || 0,
          tc: card.querySelector(".tc").value,
          status: card.querySelector(".status").value
        });
      });
      return tasks;
    }

    function generateAllocation(fitToShift = false) {
      if (!isAppEnabled) {
        return showError("Please click 'Hii Buddy' at the top right to enable the tool first.");
      }

      clearMessage();
      lastUsedFitToShift = fitToShift;

      const date = document.getElementById("date").value;
      const location = document.getElementById("location").value;
      const shift = document.getElementById("shift").value;
      const customStartTime = document.getElementById("customStartTime").value;
      const customEndTime = document.getElementById("customEndTime").value;
      const downtimeMin = Math.max(0, Number(document.getElementById("downtimeMin").value || 0));

      if (!date) return showError("Please select a date.");
      if (!location) return showError("Please select a Location first.");
      if (!shift) return showError("Please select a Shift.");

      const tasks = extractCurrentTasks();
      if (tasks.length === 0) return showError("Please add at least one task.");

      setFormLoading(true);
      showMessage(fitToShift ? "Auto-fitting tasks to the full selected shift..." : "Generating allocation based on target...", "success");

      google.script.run
        .withSuccessHandler(result => {
          setFormLoading(false);
          generatedData = result;

          resetFormTracking();

          renderOutput(result);
          document.getElementById("exportCsvBtn").style.display = "inline-flex";
          document.getElementById("copyEodBtn").style.display = "inline-flex";
          document.getElementById("searchFilterBox").style.display = "inline-flex";
          showMessage(fitToShift ? "Shift auto-fit completed successfully! Full shift balanced." : "Allocation generated successfully.", "success");
        })
        .withFailureHandler(error => {
          setFormLoading(false);
          showError(error.message || "Something went wrong.");
        })
        .generateAllocation({ date, location, shift, customStartTime, customEndTime, downtimeMin, tasks, fitToShift });
    }

    function copyText(text, btnElement) {
      navigator.clipboard.writeText(text).then(() => {
        const originalText = btnElement.innerHTML;
        btnElement.innerHTML = "✓ Copied";
