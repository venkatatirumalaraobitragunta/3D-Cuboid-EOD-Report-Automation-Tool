      html += `</tbody></table></div>`;
      output.innerHTML = html;
    }

    function updateSummary() {
      if (!generatedData) return;
      const sum = generatedData.summary;
      const productive = sum.productiveSec || 0;
      const nonProductive = sum.nonProductiveSec || 0;
      const downtimeSec = sum.downtimeSec || 0;
      const total = sum.totalSec || (productive + nonProductive);
      const available = sum.availableSec || 0;
      const remaining = sum.remainingSec !== undefined ? sum.remainingSec : Math.max(0, available - total);
      const surplus = sum.overSec || 0;
      const requiredWorkload = sum.requiredSec || total;

      let valStTotal = 0, valMtTotal = 0;
      let misStTotal = 0, misMtTotal = 0;
      let prStTotal = 0, prMtTotal = 0;

      generatedData.tasks.forEach(t => {
        valStTotal += Number(t.valSt || 0);
        valMtTotal += Number(t.valMt || 0);
        misStTotal += Number(t.misSt || 0);
        misMtTotal += Number(t.misMt || 0);
        prStTotal += Number(t.prSt || 0);
        prMtTotal += Number(t.prMt || 0);
      });

      const stObjects = valStTotal + misStTotal + prStTotal;
      const mtObjects = valMtTotal + misMtTotal + prMtTotal;
      const grandTotalObjects = stObjects + (mtObjects * 10); // weighted: ST + (MT x 10)

      const totalFP = generatedData.tasks.reduce((acc, t) => acc + Number(t.fp || 0), 0);
      const totalTC = generatedData.tasks.filter(t => t.tc === "Yes").length;

      const stSec = generatedData.actualSTSec || 0;
      const mtSec = generatedData.actualMTSec || 0;
      
      // SAME status calculation as the top progress card
      const statusInfo = computeSharedStatus(generatedData);

      // UPDATE 2: label only (no calculation change)
      // Generate Allocation -> "Allocation TPST" | Fill Full Shift -> "Auto-Fit TPST"
      document.getElementById("tpstLabel").textContent = generatedData.fitToShift ? "Auto-Fit TPST" : "Allocation TPST";

      document.getElementById("productiveValue").textContent = formatDuration(productive);
      document.getElementById("nonProductiveValue").innerHTML = downtimeSec > 0 ? 
        `<span>${formatDuration(nonProductive)}</span><span style="font-size:10px; color:#ea580c; font-weight:700;">(+${Math.round(downtimeSec/60)}m DT)</span>` : 
        formatDuration(nonProductive);

      document.getElementById("totalValue").innerHTML = surplus > 0
        ? `<span>${formatDuration(total)}</span><span style="font-size:10px; color:var(--subtext); font-weight:600;">Required: ${formatDuration(requiredWorkload)}</span>`
        : formatDuration(total);
      document.getElementById("availableValue").textContent = formatDuration(available);

      const remainingLabelEl = document.getElementById("remainingLabel");
      if (surplus > 0) {
        // Workload exceeds the shift: show Surplus (never "Over Capacity")
        if (remainingLabelEl) remainingLabelEl.textContent = "Surplus";
        document.getElementById("remainingValue").innerHTML = `
          <span style="color:#ea580c;">${formatDuration(surplus)}</span>
          <span style="font-size:10px; color:#ea580c; font-weight:700;">Surplus</span>
        `;
      } else {
        if (remainingLabelEl) remainingLabelEl.textContent = "Remaining";
        const remainingSuggestedCount = remaining > 0 ? Math.round(remaining / (Number(generatedData.targetSTSec) || 45)) : 0;
        document.getElementById("remainingValue").innerHTML = `
          <span>${formatDuration(remaining)}</span>
          ${remaining > 0 ? `<span style="font-size:10px; color:#4338ca; font-weight:700; background:#e0e7ff; padding:2px 6px; border-radius:4px; margin-top:2px;">~${remainingSuggestedCount} left</span>` : '<span style="font-size:10px; color:#16a34a; font-weight:700;">Shift Full</span>'}
        `;
      }

      document.getElementById("totalCountsValue").innerHTML = `
        <div style="font-size: 10px; line-height: 1.35; margin-bottom: 3px; border-bottom: 1px dashed var(--border); padding-bottom: 3px;">
          <div><strong style="color:var(--text);">Val:</strong> ST: ${valStTotal} | MT: ${valMtTotal}</div>
          <div><strong style="color:var(--text);">Mis:</strong> ST: ${misStTotal} | MT: ${misMtTotal}</div>
          <div><strong style="color:var(--text);">P&R:</strong> ST: ${prStTotal} | MT: ${prMtTotal}</div>
        </div>
        <div style="font-size: 11px; font-weight: 750; color: #2563eb;">
          Total ST: ${stObjects} | Total MT: ${mtObjects}
        </div>
        <div style="font-size: 12px; color: #15803d; font-weight: 800; margin: 2px 0;">
          Grand Total: ${grandTotalObjects} Count
        </div>
        <div style="color: var(--subtext); font-size: 9px;">
          FP: ${totalFP} | TC: ${totalTC}
        </div>
      `;

      let tpstDisplay = "";
      if (stObjects > 0 && mtObjects > 0) tpstDisplay = `ST: ${formatTpst(stSec)} | MT: ${formatDuration(mtSec)}`;
      else if (stObjects > 0) tpstDisplay = `ST: ${formatTpst(stSec)}`;
      else if (mtObjects > 0) tpstDisplay = `MT: ${formatDuration(mtSec)}`;
      else tpstDisplay = "NA";

      document.getElementById("tpstValue").innerHTML = `
        <span>${tpstDisplay}</span>
        ${grandTotalObjects > 0 ? `<span class="status-badge ${statusInfo.className}" style="margin-left:4px;">${statusInfo.label}</span>` : ''}
      `;

      // 10:1 Ratio for Overall TPST (1 MT = 10 ST)
      const equivalentSTUnits = stObjects + (mtObjects * 10);
      const overallTpstSec = equivalentSTUnits > 0 ? (productive / equivalentSTUnits) : 0;
      // CHANGE 2: Overall TPST display only: rounded to nearest whole second, then s or m:ss format
      const overallTpstText = formatOverallTpst(overallTpstSec);
      document.getElementById("overallTpstValue").textContent = (equivalentSTUnits > 0 && overallTpstText) ? `${overallTpstText} / count` : "NA";
    }

