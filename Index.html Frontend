    function exportToCsv() {
      if (!generatedData || !generatedData.tasks) return;
      const headers = ["Task ID", "Batch ID", "Unique Name", "Status", "Task ST Total", "Task MT Total", "Task Total Count", "Val ST", "Val MT", "Mis ST", "Mis MT", "PR ST", "PR MT", "FP", "TC"];
      const rows = generatedData.tasks.map(t => {
        const taskSt = (t.valSt || 0) + (t.misSt || 0) + (t.prSt || 0);
        const taskMt = (t.valMt || 0) + (t.misMt || 0) + (t.prMt || 0);
        const taskTotal = taskSt + (taskMt * 10); // weighted: ST + (MT x 10)
        return [
          `"${t.taskId || ''}"`, `"${t.batchId || ''}"`, `"${t.uniqueName || ''}"`, `"${t.status || 'WIP'}"`,
          taskSt, taskMt, taskTotal,
          t.valSt || 0, t.valMt || 0, t.misSt || 0, t.misMt || 0, t.prSt || 0, t.prMt || 0, t.fp || 0, `"${t.tc || 'No'}"`
        ];
      });
      const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
      const link = document.createElement("a");
      link.setAttribute("href", encodeURI(csvContent));
      link.setAttribute("download", `Allocation_${generatedData.date || 'Shift'}.csv`);
