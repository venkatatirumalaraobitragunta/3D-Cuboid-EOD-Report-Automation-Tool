    // =========================================================================
    // FILL FORM STATE
    //   📝 Fill Form            -> not opened yet
    //   ⏳ Awaiting Submission  -> form opened, waiting for a real submission
    //   ☑ Confirm Submitted     -> (only if FORM_ID is not configured) manual confirm
    //   Form Filled ✅          -> submission detected / confirmed
    // Opening the form NEVER marks it as filled.
    // =========================================================================
    function fillBtnState(i) {
      if (filledFormsTracker.has(i)) return { cls: "fill-form-btn form-filled", text: "Form Filled ✅" };
      if (openedFormsTracker.has(i)) return { cls: "fill-form-btn", text: manualConfirmTracker.has(i) ? "☑ Confirm Submitted" : "⏳ Awaiting Submission" };
      return { cls: "fill-form-btn", text: "📝 Fill Form" };
    }

    function refreshFillBtn(i) {
      const b = document.getElementById("fillBtn-" + i);
      if (!b) return;
      const s = fillBtnState(i);
      b.className = s.cls;
      b.textContent = s.text;
    }

    function stopFormPoll(i) {
      if (formPollTimers[i]) { clearTimeout(formPollTimers[i]); delete formPollTimers[i]; }
    }

    function markFormFilled(i) {
      stopFormPoll(i);
      filledFormsTracker.add(i);
      refreshFillBtn(i);
    }

    function resetFormTracking() {
      Object.keys(formPollTimers).forEach(k => clearTimeout(formPollTimers[k]));
      formPollTimers = {};
      openedFormsTracker.clear();
      filledFormsTracker.clear();
      manualConfirmTracker.clear();
    }

    // Polls the backend (every 5s, up to ~15 min) for a real form submission of this Task ID.
    function startFormPoll(index, taskId, openedAt) {
      stopFormPoll(index);
      let tries = 0;
      const next = () => { if (tries < 180) formPollTimers[index] = setTimeout(tick, 5000); };
      const tick = () => {
        tries++;
        google.script.run
          .withSuccessHandler(res => {
            if (res && res.submitted) return markFormFilled(index);
            if (res && res.configured === false) {
              // FORM_ID not set / no access -> fall back to manual confirmation
              stopFormPoll(index);
              manualConfirmTracker.add(index);
              refreshFillBtn(index);
              return;
            }
            next();
          })
          .withFailureHandler(next)
          .checkFormSubmitted(taskId, openedAt);
      };
      formPollTimers[index] = setTimeout(tick, 5000);
    }

