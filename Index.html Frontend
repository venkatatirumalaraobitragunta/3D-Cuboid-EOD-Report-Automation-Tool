<!DOCTYPE html>
<html lang="en">
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>3D Cuboid EOD Report Automation Tool</title>
  <style>
    * { box-sizing: border-box; }
    :root {
      --bg: #f4f6f9;
      --card-bg: #ffffff;
      --text: #20242b;
      --subtext: #747b87;
      --border: #e4e7ec;
      --input-border: #d9dde5;
      --primary: #4e60c7;
      --primary-hover: #4354b7;
      --accent: #4338ca;
      --highlight: #eef2ff;
      --table-header: #f8f9fa;
      --table-hover: #f7f8fc;
      --table-stripe: #fcfcfd;
    }

    body.dark-mode {
      --bg: #0f172a;
      --card-bg: #1e293b;
      --text: #f1f5f9;
      --subtext: #94a3b8;
      --border: #334155;
      --input-border: #475569;
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --accent: #818cf8;
      --highlight: #1e1b4b;
      --table-header: #1e293b;
      --table-hover: #334155;
      --table-stripe: #1e293b;
    }

    body {
      margin: 0;
      font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      transition: background-color 0.2s, color 0.2s;
    }
    button, input, select, textarea { font-family: inherit; }

    /* FLOATING TOP TOAST NOTIFICATION */
    .toast-popup {
      position: fixed;
      top: -80px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 28px;
      border-radius: 30px;
      color: #ffffff;
      font-weight: 700;
      font-size: 14px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
      transition: top 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.4s ease;
      opacity: 0;
      z-index: 10000;
      pointer-events: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .toast-popup.show {
      top: 24px;
      opacity: 1;
    }
    .toast-hii {
      background: linear-gradient(135deg, #10b981, #059669);
      border: 1px solid #34d399;
    }
    .toast-bye {
      background: linear-gradient(135deg, #f43f5e, #e11d48);
      border: 1px solid #fb7185;
    }

    .container {
      max-width: 1540px;
      margin: 0 auto;
      padding: 24px 20px 48px;
    }

    .app-locked {
      pointer-events: none;
      opacity: 0.45;
      filter: grayscale(40%);
      user-select: none;
      transition: opacity 0.3s ease, filter 0.3s ease;
    }

    .header {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 18px;
      box-shadow: 0 4px 16px rgba(31, 41, 55, 0.05);
    }
    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: var(--highlight);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: var(--primary);
    }
    .header h1 {
      margin: 0;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    .header p {
      margin: 4px 0 0;
      color: var(--subtext);
      font-size: 13px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .dark-mode-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 12px;
      border-radius: 20px;
      border: 1px solid var(--border);
      background: var(--card-bg);
      color: var(--text);
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .dark-mode-btn:hover { background: var(--highlight); }

    /* DEVELOPER-ONLY LIVE BADGE */
    .live-users-badge {
      display: none;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 20px;
      border: 1px solid #bbf7d0;
      background: #f0fdf4;
      color: #166534;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .live-users-badge:hover {
      background: #dcfce7;
      transform: translateY(-1px);
    }
    .live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse 1.5s infinite;
    }

    .feedback-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      border-radius: 20px;
      border: 1px solid #fde047;
      background: #fefce8;
      color: #854d0e;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .feedback-btn:hover { background: #fef9c3; transform: translateY(-1px); }

    .app-status-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid #c7d2fe;
      background: #eef2ff;
      color: #4338ca;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(67, 56, 202, 0.15);
    }
    .app-status-btn:hover {
      background: #e0e7ff;
      transform: translateY(-1px);
    }
    .app-status-btn.enabled {
      background: #fff1f2;
      color: #e11d48;
      border-color: #fecdd3;
      box-shadow: 0 2px 6px rgba(225, 29, 72, 0.15);
    }
    .app-status-btn.enabled:hover {
      background: #ffe4e6;
    }
    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #6366f1;
      animation: pulse 1.5s infinite;
    }
    .app-status-btn.enabled .status-dot {
      background: #e11d48;
      animation: none;
    }

    @keyframes pulse {
      0% { transform: scale(0.9); opacity: 0.8; }
      50% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(0.9); opacity: 0.8; }
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
      box-shadow: 0 3px 12px rgba(31, 41, 55, 0.04);
    }
    .card-title {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .form-row-flexible {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      align-items: end;
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    label {
      font-size: 11px;
      font-weight: 700;
      color: var(--subtext);
      letter-spacing: 0.2px;
      text-transform: uppercase;
    }
    input, select, textarea {
      width: 100%;
      height: 38px;
      padding: 0 10px;
      border: 1px solid var(--input-border);
      border-radius: 8px;
      background: var(--card-bg);
      color: var(--text);
      font-size: 13px;
      outline: none;
      transition: border-color .15s, box-shadow .15s;
    }
    textarea {
      height: 80px;
      padding: 8px 10px;
      resize: vertical;
    }
    input:hover, select:hover, textarea:hover { border-color: var(--primary); }
    input:focus, select:focus, textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
    }
    select:disabled { opacity: 0.6; cursor: not-allowed; }

    .reverse-calc-box {
      margin-top: 14px;
      padding: 12px 16px;
      background: var(--table-header);
      border: 1px dashed var(--border);
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 12px;
    }
    .reverse-calc-title { font-weight: 700; color: var(--text); }
    .reverse-calc-metrics { display: flex; gap: 16px; color: var(--subtext); }
    .reverse-calc-metrics strong { color: var(--primary); }

    .reference {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .reference-box {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 14px 12px 16px;
      overflow: hidden;
    }
    .reference-box::before {
      content: "";
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 3px;
      background: var(--primary);
    }
    .reference-box strong {
      display: block;
      font-size: 14px;
      color: var(--text);
      margin-bottom: 4px;
    }
    .reference-box span { font-size: 12px; color: var(--subtext); }

    .task-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 14px;
      transition: border-color .15s;
    }
    .task-card:hover { border-color: var(--primary); }
    .task-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .task-title-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .task-number-badge {
      width: 24px;
      height: 24px;
      border-radius: 6px;
      background: var(--highlight);
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
    }
    .task-title { font-size: 13px; font-weight: 700; color: var(--text); }

    .task-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 0.8fr 0.8fr;
      gap: 10px;
      margin-bottom: 12px;
    }

    .category-counts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      background: var(--table-header);
      padding: 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .category-box { display: flex; flex-direction: column; gap: 6px; }
    .category-title {
      font-size: 11px;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .category-inputs { display: flex; gap: 8px; }

    .button-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 16px;
      align-items: center;
    }
    button {
      border: 0;
      cursor: pointer;
      border-radius: 8px;
      height: 38px;
      padding: 0 16px;
      font-size: 12px;
      font-weight: 700;
      transition: transform .12s, box-shadow .12s, background-color .12s, opacity .12s;
    }
    button:active { transform: translateY(1px); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }

    .primary {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(78,96,199,.20);
    }
    .primary:hover:not(:disabled) { background: var(--primary-hover); }

    .fit-shift-btn {
      background: #0ea5e9;
      color: #ffffff;
      box-shadow: 0 2px 6px rgba(14,165,233,.25);
    }
    .fit-shift-btn:hover:not(:disabled) { background: #0284c7; }

    .secondary { background: var(--highlight); color: var(--text); border: 1px solid var(--border); }
    .secondary:hover { background: var(--border); }
    .add-btn {
      background: var(--highlight);
      color: var(--primary);
      border: 1px solid var(--border);
    }
    .add-btn:hover { background: var(--border); }
    .danger {
      background: #fff1f1;
      color: #c13b3b;
      border: 1px solid #ffdede;
      height: 30px;
      padding: 0 10px;
      font-size: 11px;
    }
    .danger:hover { background: #ffe8e8; }

    .reset-btn {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }
    .reset-btn:hover { background: #fecaca; }

    .utility-btn {
      background: var(--card-bg);
      color: var(--text);
      border: 1px solid var(--border);
      font-size: 11px;
      height: 32px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0 12px;
      border-radius: 6px;
    }
    .utility-btn:hover { background: var(--highlight); border-color: var(--primary); }

    .message {
      padding: 10px 14px;
      border-radius: 8px;
      margin-top: 14px;
      display: none;
      font-size: 12px;
      font-weight: 600;
    }
    .message.success { display: block; background: #eff9f1; border: 1px solid #d5eed9; color: #287139; }
    .message.error { display: block; background: #fff1f1; border: 1px solid #f3d3d3; color: #ad3030; }

    .output-section { padding: 0; overflow: hidden; }
    .output-top {
      padding: 18px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }
    .output-title { font-size: 16px; font-weight: 700; color: var(--text); }
    .output-subtitle { font-size: 12px; color: var(--subtext); margin-top: 4px; }
    .shift-pill {
      padding: 6px 12px;
      background: var(--highlight);
      color: var(--primary);
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      white-space: nowrap;
    }

    .filter-wrap { display: flex; align-items: center; gap: 8px; }
    .search-input {
      height: 32px;
      width: 200px;
      font-size: 12px;
      padding: 0 10px;
      border-radius: 6px;
    }

    .variance-alert {
      margin: 0 18px 12px;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 12px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    body.dark-mode .variance-alert {
      background: #450a0a;
      border-color: #7f1d1d;
      color: #fecaca;
    }

    /* SHARED PROGRESS BAR CARD (Generate = shift fill, Auto-Fit = target benchmark) */
    .target-gap-card {
      margin: 0 18px 14px;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--table-header);
      box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }
    .target-gap-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 8px;
    }
    .target-gap-track {
      width: 100%;
      height: 9px;
      background: rgba(148, 163, 184, 0.2);
      border-radius: 6px;
      overflow: hidden;
      position: relative;
    }
    .target-gap-fill {
      width: 0%;
      height: 100%;
      transition: width 0.4s ease, background 0.4s ease;
    }
    .gap-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 18px;
    }
    .gap-chip { white-space: nowrap; }
    .gap-chip-label { color: var(--subtext); }
    .gap-chip strong { color: var(--text); }
    .gap-note {
      margin-top: 6px;
      font-size: 11px;
      color: var(--subtext);
      font-style: italic;
    }
    .gap-stale {
      display: none;
      margin-top: 8px;
      padding: 6px 10px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.3);
      color: #b45309;
    }
    body.dark-mode .gap-stale { color: #fbbf24; }

    .legend-bar {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      padding: 12px 18px;
      background: var(--table-header);
      border-bottom: 1px solid var(--border);
    }
    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      color: var(--subtext);
    }
    .legend-dot { width: 9px; height: 9px; border-radius: 50%; }
    .status-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 10px;
      font-weight: 700;
      white-space: nowrap;
    }
    .status-green { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .status-yellow { background: #fef9c3; color: #a16207; border: 1px solid #fef08a; }
    .status-red { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .status-gray { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }

    .summary {
      display: grid;
      grid-template-columns: repeat(8, 1fr);
      gap: 10px;
      padding: 16px 18px;
    }
    .summary-box {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 12px 10px;
    }
    .summary-box .label {
      font-size: 10px;
      font-weight: 700;
      color: var(--subtext);
      text-transform: uppercase;
      letter-spacing: .4px;
      margin-bottom: 4px;
    }
    .summary-box .value { 
      font-size: 13px; 
      font-weight: 750; 
      color: var(--text); 
      display: flex; 
      align-items: center; 
      gap: 4px; 
      flex-wrap: wrap; 
    }

    .table-wrap { width: 100%; overflow-x: auto; border-top: 1px solid var(--border); }
    table { width: 100%; min-width: 1450px; border-collapse: separate; border-spacing: 0; background: var(--card-bg); }
    th {
      position: sticky; top: 0; z-index: 2;
      background: var(--table-header); color: var(--subtext);
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px;
      padding: 12px 14px; border-bottom: 1px solid var(--border); text-align: left;
    }
    td {
      padding: 12px 14px; font-size: 12px; color: var(--text);
      border-bottom: 1px solid var(--border); vertical-align: middle; white-space: nowrap;
    }
    tbody tr:nth-child(even) { background: var(--table-stripe); }
    tbody tr:hover { background: var(--table-hover); }

    .task-id-cell { font-weight: 700; color: var(--primary); min-width: 140px; }
    .task-number { display: block; color: var(--subtext); font-size: 9px; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; }

    .task-counts-card {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 120px;
      background: var(--table-header);
      padding: 6px 8px;
      border-radius: 6px;
      border: 1px solid var(--border);
    }
    .task-counts-card .sub-count {
      font-size: 10px;
      color: var(--subtext);
      display: flex;
      justify-content: space-between;
    }
    .task-counts-card .total-count-badge {
      font-size: 11px;
      font-weight: 800;
      color: var(--primary);
      border-top: 1px dashed var(--border);
      padding-top: 3px;
      margin-top: 2px;
      display: flex;
      justify-content: space-between;
    }

    .task-status-badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700;
    }
    .status-done { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .status-wip { background: #fef9c3; color: #a16207; border: 1px solid #fef08a; }
    .status-baddata { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .status-crash { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
    .status-hold { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

    .allocation-time { display: block; font-size: 11px; font-weight: 700; color: var(--text); }
    .timing-stack {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-top: 4px;
    }
    .time-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      color: var(--subtext);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    .copy-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 1px 5px;
      font-size: 9px;
      cursor: pointer;
      color: var(--text);
      height: 18px;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      transition: background 0.15s, color 0.15s;
    }
    .copy-btn:hover { background: var(--highlight); color: var(--primary); }

    .fill-form-btn {
      background: var(--highlight);
      color: var(--accent);
      border: 1px solid #c7d2fe;
      border-radius: 6px;
      padding: 0 10px;
      font-size: 11px;
      font-weight: 700;
      height: 28px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all .15s;
    }
    .fill-form-btn:hover { background: #e0e7ff; }

    .fill-form-btn.form-filled {
      background: #dcfce7;
      color: #15803d;
      border-color: #86efac;
    }
    .fill-form-btn.form-filled:hover { background: #bbf7d0; }

    .tc-yes {
      display: inline-flex; align-items: center; justify-content: center;
      height: 24px; padding: 0 8px; border-radius: 6px;
      background: #fff4e5; color: #a66408; font-size: 10px; font-weight: 700;
    }
    .tc-no {
      display: inline-flex; align-items: center; justify-content: center;
      height: 24px; padding: 0 8px; border-radius: 6px;
      background: var(--highlight); color: var(--subtext); font-size: 10px; font-weight: 700;
    }
    .output-remove {
      height: 28px; padding: 0 10px; border-radius: 6px;
      background: #fff2f2; border: 1px solid #ffdada; color: #c33b3b; font-size: 10px; font-weight: 700;
    }
    .output-remove:hover { background: #ffe8e8; }
    .empty-output { padding: 48px 20px; text-align: center; color: var(--subtext); font-size: 13px; }
    .empty-output-title { color: var(--text); font-size: 14px; font-weight: 700; margin-bottom: 4px; }

    .app-footer {
      margin-top: 36px;
      padding: 20px 24px;
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 12px;
      color: var(--subtext);
    }
    .footer-credit-title { font-weight: 700; color: var(--text); font-size: 13px; }
    .footer-details { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
    .footer-item { display: inline-flex; align-items: center; gap: 5px; }
    .footer-item strong { color: var(--text); }
    .footer-item a { color: var(--primary); text-decoration: none; font-weight: 600; }
    .footer-item a:hover { text-decoration: underline; }

    .modal {
      display: none; position: fixed; inset: 0;
      background: rgba(20, 24, 32, .45);
      align-items: center; justify-content: center; z-index: 999;
    }
    .modal-box {
      width: 90%; max-width: 540px; background: var(--card-bg);
      border-radius: 12px; padding: 22px; box-shadow: 0 15px 40px rgba(0,0,0,.25);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .modal-box h3 { margin: 0 0 8px; font-size: 16px; }
    .modal-box p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--subtext); }
    .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }

    .star-group { display: flex; gap: 8px; margin: 14px 0; }
    .star-item { font-size: 24px; cursor: pointer; color: #cbd5e1; transition: color 0.15s, transform 0.15s; }
    .star-item:hover, .star-item.selected { color: #f59e0b; transform: scale(1.1); }

    @media (max-width: 1100px) {
      .task-meta-grid { grid-template-columns: 1fr 1fr; }
      .category-counts-grid { grid-template-columns: 1fr; }
      .summary { grid-template-columns: repeat(4, 1fr); }
    }
    @media (max-width: 768px) {
      .summary { grid-template-columns: repeat(2, 1fr); }
      .reference { grid-template-columns: repeat(2, 1fr); }
    }

    /* =====================================================================
       PRODUCTION REFERENCE CALCULATOR (NEW, ISOLATED)
       Every selector below is scoped under .refCalc_container and every
       class starts with refCalc_. Nothing above this block was changed.
       ===================================================================== */
    .refCalc_container {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      margin: 16px 0 16px;
      box-shadow: 0 3px 12px rgba(31, 41, 55, 0.04);
      color: var(--text);
    }
    .refCalc_container .refCalc_title {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 4px;
      color: var(--text);
    }
    .refCalc_container .refCalc_subtitle {
      font-size: 12px;
      color: var(--subtext);
      margin-bottom: 16px;
    }
    .refCalc_container .refCalc_grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      align-items: end;
    }
    .refCalc_container .refCalc_field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .refCalc_container .refCalc_hint {
      font-size: 11px;
      color: var(--subtext);
    }
    .refCalc_container .refCalc_message {
      display: none;
      margin-top: 12px;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 600;
      background: #fff1f1;
      border: 1px solid #f3d3d3;
      color: #ad3030;
    }
    .refCalc_container .refCalc_message.refCalc_show { display: block; }
    .refCalc_container .refCalc_tableWrap {
      width: 100%;
      overflow-x: auto;
      margin-top: 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
    }
    .refCalc_container table.refCalc_table {
      width: 100%;
      min-width: 0;
      border-collapse: collapse;
      background: var(--card-bg);
    }
    .refCalc_container table.refCalc_table th {
      position: static;
      background: var(--table-header);
      color: var(--subtext);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .4px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      text-align: left;
    }
    .refCalc_container table.refCalc_table td {
      padding: 10px 14px;
      font-size: 13px;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
      vertical-align: middle;
    }
    .refCalc_container table.refCalc_table tbody tr:last-child td { border-bottom: 0; }
    .refCalc_container table.refCalc_table tbody tr:nth-child(even) { background: transparent; }
    .refCalc_container table.refCalc_table tbody tr:hover { background: var(--table-hover); }
    .refCalc_container .refCalc_mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 700;
    }
    .refCalc_container .refCalc_big { font-size: 15px; font-weight: 800; color: var(--primary); }
    .refCalc_container .refCalc_checkInput {
      height: 30px;
      width: 120px;
      font-size: 12px;
    }
    .refCalc_container .refCalc_badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 3px 8px;
      border-radius: 12px;
      font-size: 10px;
      font-weight: 700;
      white-space: nowrap;
    }
    .refCalc_container .refCalc_green  { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .refCalc_container .refCalc_yellow { background: #fef9c3; color: #a16207; border: 1px solid #fef08a; }
    .refCalc_container .refCalc_red    { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .refCalc_container .refCalc_gray   { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .refCalc_container .refCalc_note {
      margin-top: 10px;
      font-size: 11px;
      color: var(--subtext);
    }
  </style>
</head>

<body>
  <!-- TOP FLOATING TOAST -->
  <div id="toastNotification" class="toast-popup"></div>

  <div class="container">
    <div class="header">
      <div class="header-top">
        <div class="brand">
          <div class="brand-icon">⏱</div>
          <div>
            <h1>3D Cuboid EOD Report Automation Tool</h1>
            <p>Task-based production time allocation & EOD report automation</p>
          </div>
        </div>

        <div class="header-actions">
          <button type="button" class="dark-mode-btn" onclick="toggleDarkMode()">
            <span id="darkModeIcon">🌙</span> Dark Mode
          </button>
          
          <!-- DEVELOPER-ONLY LIVE BADGE -->
          <button type="button" id="liveUsersBadge" class="live-users-badge" onclick="openLiveUsersModal()">
            <span class="live-dot"></span>
            <span id="liveUsersCountText">Live: 1</span>
          </button>

          <!-- ALWAYS VISIBLE FEEDBACK BUTTON -->
          <button type="button" id="headerFeedbackBtn" class="feedback-btn" onclick="openFeedbackModal()">
            ⭐ Share Feedback
          </button>

          <button type="button" id="toggleAppBtn" class="app-status-btn" onclick="toggleToolStatus()">
            <span class="status-dot"></span>
            <span id="btnStatusText">Hii Buddy (Click to Enable)</span>
          </button>
        </div>
      </div>
    </div>

    <div id="mainAppContent" class="app-locked">
      <div class="card">
        <div class="card-title">Shift Details & Target</div>
        <div class="form-row-flexible">
          <div class="field">
            <label for="date">Date</label>
            <input type="date" id="date" onchange="autoSave()">
          </div>

          <!-- NEW: LOCATION -->
          <div class="field">
            <label for="location" style="color: #6366f1;">Location</label>
            <select id="location" onchange="handleLocationChange()">
              <option value="">Select Location</option>
              <option value="Hyderabad">Hyderabad</option>
              <option value="Saltlake">Saltlake</option>
              <option value="Metiabrux">Metiabrux</option>
            </select>
          </div>

          <!-- SHIFT (options are filled dynamically from the selected Location) -->
          <div class="field">
            <label for="shift">Shift</label>
            <select id="shift" onchange="handleShiftChange()"></select>
          </div>
          <div class="field" id="customStartTimeField" style="display: none;">
            <label for="customStartTime" style="color: #6366f1;">Custom Start Time</label>
            <input type="time" id="customStartTime" value="09:00" onchange="updateRefLabel(); autoSave();">
          </div>
          <div class="field" id="customEndTimeField" style="display: none;">
            <label for="customEndTime" style="color: #6366f1;">Custom End Time</label>
            <input type="time" id="customEndTime" value="17:30" onchange="updateRefLabel(); autoSave();">
          </div>
          <div class="field">
            <label for="downtimeMin" style="color: #ea580c;">Downtime / Meeting (Min)</label>
            <input type="number" id="downtimeMin" placeholder="Optional (e.g. 15)" min="0" max="720" step="1" oninput="updateRefLabel(); autoSave();">
          </div>
        </div>

        <div class="reverse-calc-box">
          <div>
            <div class="reverse-calc-title">🎯 Reverse Target Planner</div>
            <span id="reverseCalcDesc" style="color: var(--subtext);">Standard benchmark (7:30 hrs @ 45s ST / 6:00m MT target):</span>
          </div>
          <div class="reverse-calc-metrics">
            <span>Required ST Count: <strong id="reqStCount">~600</strong></span>
            <span>or MT Count: <strong id="reqMtCount">~75</strong></span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Time Reference</div>
        <div class="reference">
          <div class="reference-box">
            <strong>ST Rate</strong>
            <span id="refSTRate">Selected: 45 sec / object</span>
          </div>
          <div class="reference-box">
            <strong>MT Rate</strong>
            <span id="refMTRate">6:00 min (360 sec) / object</span>
          </div>
          <div class="reference-box">
            <strong>FP (Fixed)</strong>
            <span>30 sec / object</span>
          </div>
          <div class="reference-box">
            <strong>TC (Fixed)</strong>
            <span>15 min / task</span>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">
          <span>Task Input <span style="font-size: 11px; font-weight: normal; color: var(--subtext);">(Shortcuts: Alt+A = New Task, Ctrl+Enter = Generate)</span></span>
          <button type="button" class="utility-btn" onclick="openBulkPasteModal()">📋 Batch/Bulk Paste from Sheet</button>
        </div>
        <div id="tasksContainer"></div>

        <button type="button" class="add-btn" onclick="addTask(); autoSave();">+ Add Another Task (Alt+A)</button>

        <div class="button-row">
          <button type="button" id="generateBtn" class="primary" onclick="generateAllocation(false)">Generate Allocation (Ctrl+Enter)</button>
          <button type="button" id="fitShiftBtn" class="fit-shift-btn" onclick="generateAllocation(true)">⚡ Fill Full Shift (Auto-Fit Count)</button>
          <button type="button" class="reset-btn" onclick="openResetModal()">Refresh / Clear All</button>
        </div>

        <div id="message" class="message"></div>
      </div>

      <div class="card output-section">
        <div class="output-top">
          <div>
            <div class="output-title">Allocation Output</div>
            <div id="outputSubtitle" class="output-subtitle">Generate an allocation to view task timings.</div>
          </div>
          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <div class="filter-wrap" id="searchFilterBox" style="display: none;">
              <input type="text" id="tableSearchInput" class="search-input" placeholder="🔍 Search Task / Batch ID..." onkeyup="filterTableRows()">
            </div>
            <button type="button" id="exportCsvBtn" class="utility-btn" onclick="exportToCsv()" style="display: none;">📥 Export CSV</button>
            <button type="button" id="copyEodBtn" class="utility-btn" onclick="copyEodSummary(this)" style="display: none;">📋 Copy EOD Summary</button>
            <div id="shiftPill" class="shift-pill" style="display:none;"></div>
          </div>
        </div>

        <div id="varianceAlert" class="variance-alert" style="display: none;">
          ⚠️ <strong>Variance Alert:</strong> <span id="varianceMessage"></span>
        </div>

        <!-- SHARED PROGRESS BAR (ONE BAR, TWO MODES):
             Generate Allocation  -> Shift Allocation Progress (required workload vs shift)
             Fill Full Shift      -> Target-rate benchmark progress (workload vs capacity)
             Bar color + badge always come from the shared status (computeSharedStatus). -->
        <div id="targetGapCard" class="target-gap-card" style="display: none;">
          <div class="target-gap-header">
            <span id="targetGapTitle" style="font-size: 13px; font-weight: 700; color: var(--text);">Shift Pace Status</span>
            <span id="targetGapBadge" style="font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px;"></span>
          </div>
          
          <div class="target-gap-track">
            <div id="targetGapBar" class="target-gap-fill"></div>
          </div>

          <div id="targetGapDetails" style="font-size: 12px; margin-top: 8px; line-height: 1.6; color: var(--subtext);"></div>
          <div id="targetGapStale" class="gap-stale">⟳ Inputs changed since the last run. Click Generate Allocation or Fill Full Shift to refresh this bar.</div>
        </div>

        <!-- STRICT COLOR LEGEND BAR -->
        <div id="legendBar" class="legend-bar" style="display:none;">
          <div class="legend-item"><span class="legend-dot" style="background:#22c55e;"></span> On Track (ST ≤ 45s AND MT ≤ 6 min)</div>
          <div class="legend-item"><span class="legend-dot" style="background:#eab308;"></span> Close (ST ≤ 60s AND MT ≤ 8 min)</div>
          <div class="legend-item"><span class="legend-dot" style="background:#ef4444;"></span> Needs Attention (ST > 60s OR MT > 8 min)</div>
          <div class="legend-item"><span class="legend-dot" style="background:#94a3b8;"></span> No Activity (Total Count = 0)</div>
        </div>

        <div id="summary" class="summary" style="display:none;">
          <div class="summary-box">
            <div class="label">Productive</div>
            <div class="value" id="productiveValue">00:00:00</div>
          </div>
          <div class="summary-box">
            <div class="label">Non-Productive</div>
            <div class="value" id="nonProductiveValue">00:00:00</div>
          </div>
          <div class="summary-box">
            <div class="label">Total Counts</div>
            <div class="value" id="totalCountsValue" style="color: #2563eb; font-size: 11px; line-height: 1.4;">--</div>
          </div>
          <div class="summary-box">
            <!-- UPDATE 2: label text is switched in updateSummary() (Allocation TPST / Auto-Fit TPST) -->
            <div class="label" id="tpstLabel">Allocation TPST</div>
            <div class="value" id="tpstValue">--</div>
          </div>
          <div class="summary-box">
            <div class="label">Overall TPST</div>
            <div class="value" id="overallTpstValue" style="color:#4f46e5;">--</div>
          </div>
          <div class="summary-box">
            <div class="label">Total Allocated</div>
            <div class="value" id="totalValue">00:00:00</div>
          </div>
          <div class="summary-box">
            <div class="label" id="availableLabel">Available Shift</div>
            <div class="value" id="availableValue">07:30:00</div>
          </div>
          <div class="summary-box">
            <div class="label" id="remainingLabel">Remaining</div>
            <div class="value" id="remainingValue" style="flex-direction: column; align-items: flex-start; gap: 2px;">07:30:00</div>
          </div>
        </div>

        <div id="outputArea" class="empty-output">
          <div class="empty-output-title">No allocation generated</div>
          Enter your task details and generate allocation.
        </div>
      </div>

      <div class="app-footer">
        <div class="footer-credit-title">Developed for 3D Cuboid Annotation Workflow</div>
        <div class="footer-details">
          <span class="footer-item"><strong>Developer:</strong> Bitragunta Venkata Tirumalarao</span>
          <span class="footer-item"><strong>Contact:</strong> <a href="mailto:bitragunta.t@imerit.net">bitragunta.t@imerit.net</a></span>
        </div>
      </div>
    </div>

    <!-- =====================================================================
         PRODUCTION REFERENCE CALCULATOR (NEW, ISOLATED)
         Placed OUTSIDE #mainAppContent so it is independent of the
         "Hii Buddy" enable/lock switch and shares no state with the main tool.
         ===================================================================== -->
    <div id="refCalc_container" class="refCalc_container">
      <div class="refCalc_title">🧮 Production Reference Calculator</div>
      <div class="refCalc_subtitle">Independent reference tool. It does not read or change the main tool's location, shift or data.</div>

      <div class="refCalc_grid">
        <div class="refCalc_field">
          <label for="refCalc_location">Location</label>
          <select id="refCalc_location">
            <option value="Hyderabad">Hyderabad</option>
            <option value="Saltlake">Saltlake</option>
            <option value="Metiabrux">Metiabrux</option>
          </select>
        </div>

        <div class="refCalc_field">
          <label for="refCalc_mode">Mode</label>
          <select id="refCalc_mode">
            <option value="standard" selected>Standard Mode</option>
            <option value="normal">Normal Mode</option>
          </select>
        </div>

        <div class="refCalc_field">
          <label for="refCalc_workingTime">Working Time (HH:MM:SS)</label>
          <input type="text" id="refCalc_workingTime" value="07:30:00" placeholder="07:30:00" autocomplete="off" inputmode="numeric">
        </div>

        <div class="refCalc_field" id="refCalc_countField" style="display: none;">
          <label for="refCalc_count">Count (whole number)</label>
          <input type="text" id="refCalc_count" value="" placeholder="e.g. 600" autocomplete="off" inputmode="numeric" pattern="[0-9]*">
        </div>
      </div>

      <div id="refCalc_message" class="refCalc_message"></div>

      <div id="refCalc_result"></div>
    </div>
  </div>

  <!-- BULK PASTE MODAL -->
  <div id="bulkPasteModal" class="modal">
    <div class="modal-box">
      <h3>Batch / Bulk Paste Tasks</h3>
      <p>Paste tasks copied directly from Excel / Google Sheets or combined string.<br>
      <strong>Combined Format:</strong> <code>BatchID + TaskID(UUID) + LSR_ID</code><br>
      <strong>Tab Format:</strong> <code>Batch | TaskID | UniqueName | ValST | ValMT | MisST | MisMT | PrST | PrMT | FP | TC</code></p>
      
      <div style="margin-top: 12px;">
        <textarea id="bulkPasteInput" style="height: 140px; font-family: monospace; font-size: 11px;" placeholder="Imerit-Batch-Pre-Label-LV-3883-near-range3900c65c-acf3-43e1-b675-7d9a64c2000f6a6d2de24005c6e3bb34a40b"></textarea>
      </div>

      <div class="modal-actions">
        <button type="button" class="secondary" onclick="closeBulkPasteModal()">Cancel</button>
        <button type="button" class="primary" onclick="processBulkPaste()">Import Tasks</button>
      </div>
    </div>
  </div>

  <!-- RESET MODAL -->
  <div id="resetModal" class="modal">
    <div class="modal-box">
      <h3>Do you Want Reset ?</h3>
      <p>This will clear all entered tasks, shift inputs, and saved data from your browser.</p>
      <div class="modal-actions">
        <button type="button" class="secondary" onclick="closeResetModal()">Cancel</button>
        <button type="button" class="danger" onclick="confirmReset()">Yes, Reset</button>
      </div>
    </div>
  </div>

  <!-- DELETE MODAL -->
  <div id="deleteModal" class="modal">
    <div class="modal-box">
      <h3>Remove Task?</h3>
      <p>Are you sure you want to remove this task from the allocation output?</p>
      <div class="modal-actions">
        <button type="button" class="secondary" onclick="closeDeleteModal()">Cancel</button>
        <button type="button" class="danger" onclick="confirmDelete()">Remove</button>
      </div>
    </div>
  </div>

  <!-- FEEDBACK MODAL -->
  <div id="feedbackModal" class="modal">
    <div class="modal-box">
      <h3>How is your experience? 🚀</h3>
      <p>Share your feedback about the 3D Cuboid EOD Report Automation Tool.</p>
      <div style="margin-top: 14px;">
        <label>Your Rating</label>
        <div class="star-group" id="starContainer">
          <span class="star-item" onclick="setRating(1)">★</span>
          <span class="star-item" onclick="setRating(2)">★</span>
          <span class="star-item" onclick="setRating(3)">★</span>
          <span class="star-item" onclick="setRating(4)">★</span>
          <span class="star-item selected" onclick="setRating(5)">★</span>
        </div>
      </div>
      <div class="field" style="margin-bottom: 12px;">
        <label>Your Name (Optional)</label>
        <input type="text" id="feedbackName" placeholder="e.g. Ramesh / Annotator">
      </div>
      <div class="field">
        <label>Feedback / Suggestions</label>
        <textarea id="feedbackComments" placeholder="What do you like or what can we improve?"></textarea>
      </div>
      <div class="modal-actions">
        <button type="button" class="secondary" onclick="closeFeedbackModal()">Cancel</button>
        <button type="button" id="submitFeedbackBtn" class="primary" onclick="submitFeedback()">Submit Feedback</button>
      </div>
    </div>
  </div>

  <!-- DEVELOPER-ONLY LIVE ACTIVE USERS MODAL -->
  <div id="liveUsersModal" class="modal">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h3 style="margin:0;">🟢 Live Active Users Online</h3>
        <button type="button" class="utility-btn" onclick="fetchLiveUsers()">🔄 Refresh</button>
      </div>
      <p style="font-size:12px; color:var(--subtext); margin-bottom:14px;">
        Users who pinged in the last 2 minutes. (Visible only to Developer)
      </p>
      <div id="liveUsersListArea" style="max-height:260px; overflow-y:auto; border:1px solid var(--border); border-radius:8px; padding:10px; background:var(--table-header); font-size:12px;">
        Loading live active annotators...
      </div>
      <div class="modal-actions">
        <button type="button" class="secondary" onclick="closeLiveUsersModal()">Close</button>
      </div>
    </div>
  </div>

  <script>
    // =========================================================================
    // LOCATION-WISE PRODUCTION SHIFTS
    // These are final production windows (NO extra break deduction).
