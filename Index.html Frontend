    // ---------------------------------------------------------------------
    // LOCATION -> SHIFT HANDLING
    // ---------------------------------------------------------------------
    function to12Hour(hhmm) {
      const parts = String(hhmm).split(":").map(Number);
      const h = parts[0], m = parts[1] || 0;
      const suffix = h >= 12 ? "PM" : "AM";
      const h12 = h % 12 === 0 ? 12 : h % 12;
      return `${String(h12).padStart(2, "0")}:${String(m).padStart(2, "0")} ${suffix}`;
    }

    // Rebuilds the Shift dropdown for the chosen location.
    // Only that location's shifts + Custom Shift are ever shown.
    function populateShiftOptions(location, selectedShift) {
      const select = document.getElementById("shift");
      select.innerHTML = "";

      if (!location || !LOCATION_SHIFTS[location]) {
        const opt = document.createElement("option");
        opt.value = "";
        opt.textContent = "Select Location first";
        select.appendChild(opt);
        select.disabled = true;
        return;
      }

      select.disabled = false;
      Object.keys(LOCATION_SHIFTS[location]).forEach(name => {
        const s = LOCATION_SHIFTS[location][name];
        const opt = document.createElement("option");
        opt.value = name;
        opt.textContent = `${name} — ${to12Hour(s.start)} to ${to12Hour(s.end)}`;
        select.appendChild(opt);
      });

      const customOpt = document.createElement("option");
      customOpt.value = "Custom";
      customOpt.textContent = "Custom Shift";
      select.appendChild(customOpt);

      const wanted = selectedShift && Array.from(select.options).some(o => o.value === selectedShift)
        ? selectedShift
        : "Shift 1";
      select.value = wanted;
    }

    function handleLocationChange() {
