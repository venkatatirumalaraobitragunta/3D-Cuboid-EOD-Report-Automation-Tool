          </tr>
        </thead>
        <tbody>${userRowsHtml}</tbody>
      </table>
    </div>
  `;

  MailApp.sendEmail({ to: CONFIG.DEVELOPER_EMAIL, subject: emailSubject, htmlBody: emailHtml });
}

function setupDailyEodTrigger() {
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => {
    if (t.getHandlerFunction() === "sendDailyUsageSummaryEmail") {
      ScriptApp.deleteTrigger(t);
    }
  });

  ScriptApp.newTrigger("sendDailyUsageSummaryEmail").timeBased().everyDays(1).atHour(0).create();
  Logger.log("Daily Midnight Trigger set successfully!");
}

// -------------------------------------------------------------
// ONE-TIME CLEANUP: personal shift-end email feature (removed)
// Run this ONCE manually from the Apps Script editor after saving.
// It deletes ONLY:
//   1) triggers whose handler is exactly "sendPersonalShiftEndReportTrigger"
//   2) legacy script properties named SCHEDULED_<yyyy-MM-dd>_...
//      (including any ..._SENT markers that follow that same pattern)
//   3) V2 script properties named SCHEDULED_V2_...
//      (including their ..._SENT markers)
// It does NOT touch: the daily summary trigger (sendDailyUsageSummaryEmail),
// DAILY_LOG_* properties, feedback code, or any other trigger / property.
// After it reports 0 remaining, you may delete this function.
// -------------------------------------------------------------
function cleanupPersonalShiftEndEmailFeature() {
  const HANDLER_NAME = "sendPersonalShiftEndReportTrigger";
  const LEGACY_PROP_PATTERN = /^SCHEDULED_\d{4}-\d{2}-\d{2}_/;
  const V2_PROP_PATTERN = /^SCHEDULED_V2_/;

  // 1) Triggers (exact handler-name match only)
  let triggersDeleted = 0;
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === HANDLER_NAME) {
      ScriptApp.deleteTrigger(t);
      triggersDeleted++;
    }
  });

  // 2) Script properties (legacy + V2, including _SENT markers)
  const props = PropertiesService.getScriptProperties();
  let legacyPropsDeleted = 0;
  let v2PropsDeleted = 0;
  let v2SentMarkersDeleted = 0;

  props.getKeys().forEach(key => {
    if (V2_PROP_PATTERN.test(key)) {
      props.deleteProperty(key);
      v2PropsDeleted++;
      if (/_SENT$/.test(key)) v2SentMarkersDeleted++;
    } else if (LEGACY_PROP_PATTERN.test(key)) {
      props.deleteProperty(key);
      legacyPropsDeleted++;
    }
  });

  // 3) Verify
  const remainingTriggers = ScriptApp.getProjectTriggers()
    .filter(t => t.getHandlerFunction() === HANDLER_NAME).length;
  const remainingProps = props.getKeys()
    .filter(k => V2_PROP_PATTERN.test(k) || LEGACY_PROP_PATTERN.test(k)).length;

  const summary = {
    triggersDeleted: triggersDeleted,
    legacyPropertiesDeleted: legacyPropsDeleted,
    v2PropertiesDeleted: v2PropsDeleted,
    v2SentMarkersDeleted: v2SentMarkersDeleted,
    remainingPersonalShiftEndTriggers: remainingTriggers,
    remainingScheduledProperties: remainingProps
  };
  Logger.log("Cleanup complete: " + JSON.stringify(summary));
  return summary;
}

// -------------------------------------------------------------
// OPTIONAL READ-ONLY AUDIT (deletes nothing)
// Run before and after the cleanup to see what exists.
// You may delete this function once you have verified the result.
// -------------------------------------------------------------
function auditPersonalShiftEndEmailFeature() {
  const HANDLER_NAME = "sendPersonalShiftEndReportTrigger";
  const LEGACY_PROP_PATTERN = /^SCHEDULED_\d{4}-\d{2}-\d{2}_/;
  const V2_PROP_PATTERN = /^SCHEDULED_V2_/;

  const triggers = ScriptApp.getProjectTriggers();
  const keys = PropertiesService.getScriptProperties().getKeys();

  const report = {
    personalShiftEndTriggers: triggers.filter(t => t.getHandlerFunction() === HANDLER_NAME).length,
    dailySummaryTriggers: triggers.filter(t => t.getHandlerFunction() === "sendDailyUsageSummaryEmail").length,
    otherTriggerHandlers: triggers.map(t => t.getHandlerFunction())
      .filter(h => h !== HANDLER_NAME && h !== "sendDailyUsageSummaryEmail"),
    legacyScheduledProperties: keys.filter(k => LEGACY_PROP_PATTERN.test(k)).length,
    v2ScheduledProperties: keys.filter(k => V2_PROP_PATTERN.test(k)).length,
    dailyLogProperties: keys.filter(k => k.indexOf("DAILY_LOG_") === 0).length,
    // Keys that look related but do NOT match the cleanup patterns (these are NOT deleted):
    possibleUnmatchedLeftovers: keys.filter(k =>
      (/SCHEDULED|_SENT$/.test(k)) && !LEGACY_PROP_PATTERN.test(k) && !V2_PROP_PATTERN.test(k))
  };
  Logger.log("Audit: " + JSON.stringify(report, null, 2));
  return report;
}
