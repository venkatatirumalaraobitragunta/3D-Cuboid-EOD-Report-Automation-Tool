function getUserInfo() {
  try {
    const email = (Session.getActiveUser().getEmail() || "").toLowerCase().trim();
    let name = "Buddy";
    if (email.includes("@")) {
      const raw = email.split("@")[0].replace(/[._]/g, " ");
      name = raw.replace(/\b\w/g, c => c.toUpperCase());
    }
    const isDeveloper = (email === CONFIG.DEVELOPER_EMAIL.toLowerCase().trim());
    return { name, email, isDeveloper };
  } catch (e) {
    return { name: "Buddy", email: "", isDeveloper: false };
  }
