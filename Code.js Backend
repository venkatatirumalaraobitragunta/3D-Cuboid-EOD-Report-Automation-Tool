function recordFormFillEvent(eventData) {
  try {
    let userEmail = Session.getActiveUser().getEmail();
    if (!userEmail) userEmail = "Anonymous / Shared User";
    userEmail = userEmail.toLowerCase().trim();

    const props = PropertiesService.getScriptProperties();
    const todayKey = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");

    const existingRaw = props.getProperty("DAILY_LOG_" + todayKey);
    let logList = existingRaw ? JSON.parse(existingRaw) : [];

    logList.push({
      email: userEmail,
      taskId: eventData && eventData.taskId ? eventData.taskId : "Unknown",
      status: eventData && eventData.status ? eventData.status : "WIP",
      location: eventData && eventData.location ? eventData.location : "Unknown",
      shift: eventData && eventData.shift ? eventData.shift : "Shift 1",
      time: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "HH:mm:ss")
    });

    props.setProperty("DAILY_LOG_" + todayKey, JSON.stringify(logList));

    return { success: true };
  } catch (err) {
    console.error("Error logging event: ", err);
    return { success: false, error: err.message };
  }
}

